{
	"schemaVersion": 1,

	"hyprland": {
		"modifier": "SUPER",

		"applications": {
			"terminal": "kitty"
		},

		"keybindings": {
			"terminal": "RETURN",
			"launcher": "D",
			"lock": "L",
			"clipboard": "V",
			"closeWindow": "Q",
			"fullscreen": "F",
			"maximize": "M",
			"exit": "SHIFT + E",
			"screenshot": "Print",
			"emptyWorkspace": "N",
			"nextWorkspace": "Tab"
		},

		"monitors": [
			{
				"output": "HDMI-A-2",
				"mode": "3840x2160@60",
				"position": "0x590",
				"scale": 1.5
			},

			{
				"output": "DP-4",
				"mode": "2560x1440@180",
				"position": "2560x590",
				"scale": 1
			},

			{
				"output": "DP-3",
				"mode": "2560x1440@60",
				"position": "5120x0",
				"scale": 1,
				"transform": 3
			}
		]
	},

	"quickshell": {
		"appearance": {
			"textColor": "white"
		},

		"bar": {
			"height": 36,
			"backgroundColor": "#202020",
			"outerMargin": 12,
			"componentSpacing": 12
		},

		"tray": {
			"spacing": 6,
			"iconSize": 18
		},

		"workspaces": {
			"spacing": 8,
			"horizontalPadding": 8,
			"height": 24,
			"focusedColor": "white",
			"activeColor": "#bbbbbb",
			"inactiveColor": "#666666"
		},

		"audio": {
			"volumeStep": 0.05,
			"mutedLabel": "MUTE",
			"unavailableLabel": "--"
		},

		"clock": {
			"format": "hh:mm"
		},

		"status": {
			"spacing": 4
		},

		"bluetooth": {
			"enabledLabel": "BT",
			"disabledLabel": "BT OFF",
			"unavailableLabel": "NO BT"
		}
	}
}
